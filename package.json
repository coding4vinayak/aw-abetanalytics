{
  "name": "abetanalytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3600",
    "build": "next build",
    "start": "next start -p ${PORT:-3600}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "check:contract": "tsx scripts/check-contract.mts",
    "check:llms-full": "tsx scripts/build-llms-full.mts --check",
    "build:llms-full": "tsx scripts/build-llms-full.mts",
    "seed:key": "tsx prisma/seed-key.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
