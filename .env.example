# AbetAnalytics - Revenue intelligence
# Local Postgres via `docker compose up -d` (any Postgres 15+ works).
DATABASE_URL="postgresql://abetanalytics:abetanalytics@localhost:5432/abetanalytics"
REDIS_URL="redis://localhost:6379"
PRODUCT_NAME=AbetAnalytics
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3600

# Email delivery for verification + password reset. Unset, links are written to
# the server log and the UI says so instead of claiming a message was sent.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Abetworks <noreply@yourdomain.com>

# Billing (Stripe). Create a monthly and an annual price in Stripe, then set
# these. Unset, /pricing still renders and checkout answers 500.
# STRIPE_SECRET_KEY=sk_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_FLAT_MONTHLY=price_xxx
# STRIPE_PRICE_FLAT_ANNUAL=price_xxx
# Local webhooks: stripe listen --forward-to localhost:3600/api/billing/webhook
